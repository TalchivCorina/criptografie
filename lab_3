ALFABET = "AĂÂBCDEFGHIJKLMNOPQRSȘTȚUVWXYZ"
LATIN = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"

RANDURI = 5
COLOANE = 6
LUNGIME_MIN_CHEIE = 7


# Verifica daca un caracter este litera latina A-Z sau a-z
def este_latin(c):
    return c.upper() in LATIN and c.isascii()

# Verifica mesajul: doar A-Z si a-z
def pregateste_mesaj(text):
    if not text:
        raise ValueError("Mesajul nu poate fi gol")

    if not all(este_latin(c) for c in text):
        raise ValueError(
            "Mesajul contine caractere necorespunzătoare \n"
            "Diapazon corect: litere de la 'A' la 'Z' si de la 'a' la 'z' "
            "(fara spatii, cifre, diacritice sau semne)."
        )

    return text.upper()

# Cere mesajul pana cand este introdus corect
def citeste_mesaj():
    while True:
        mesaj = input("\nIntrodu mesajul: ")

        try:
            return pregateste_mesaj(mesaj)
        except ValueError as eroare:
            print("\nEroare:", eroare)
            print("Introdu din nou mesajul")

# Verifica criptograma: A-Z, Ă, Â, Î, Ș, Ț
# Criptograma trebuie sa aiba lungime para
def pregateste_criptograma(text):
    if not text:
        raise ValueError("Criptograma nu poate fi goala")

    if not all(c.upper() in ALFABET + "Î" for c in text):
        raise ValueError(
            "Criptograma contine caractere necorespunzătoare\n"
            "Diapazon corect: litere de la 'A' la 'Z' si "
            "Ă Â Î Ș Ț (fara spatii, cifre sau alte semne)."
        )

    if len(text) % 2 != 0:
        raise ValueError(
            f"Criptograma trebuie sa aiba lungime para "
            f"(acum are {len(text)} simboluri)."
        )

    # Î se afla in aceeasi celula cu I
    return text.upper().replace("Î", "I")

# Cere criptograma pana cand este introdusa corect
def citeste_criptograma():
    while True:
        cripto = input("\nIntrodu criptograma: ")

        try:
            return pregateste_criptograma(cripto)
        except ValueError as eroare:
            print("\nEroare:", eroare)
            print("Introdu din nou criptograma")

# Citeste cheia: minimum 7 litere latine
def citeste_cheie():
    while True:
        cheie = input("Introdu cheia (minim 7 litere): ")

        if len(cheie) < LUNGIME_MIN_CHEIE:
            print(
                f"Cheia trebuie sa aiba cel putin "
                f"{LUNGIME_MIN_CHEIE} litere."
            )
            continue

        if not all(este_latin(c) for c in cheie):
            print(
                "Diapazon corect: litere de la 'A' la 'Z' "
                "si de la 'a' la 'z' "
                "(fara spatii, cifre sau diacritice."
            )
            continue

        return cheie.upper()

# Construieste tabelul 5x6: mai intai cheia, apoi restul alfabetului
def construieste_tabel(cheie):
    simboluri = ""

    for c in cheie + ALFABET:
        if c not in simboluri:
            simboluri += c

    simboluri = simboluri[:RANDURI * COLOANE]

    return [
        simboluri[i:i + COLOANE]
        for i in range(0, RANDURI * COLOANE, COLOANE)
    ]

# Afiseaza tabelul; celula lui I apare ca I/Î
def afiseaza_tabel(tabel):
    print("\nTabelul Playfair 5x6:")

    for rand in tabel:
        print(
            "  " + " ".join(
                ("I/Î" if c == "I" else c).ljust(3)
                for c in rand
            )
        )

# Returneaza randul si coloana unui simbol
def gaseste_pozitie(tabel, c):
    for r in range(RANDURI):
        for k in range(COLOANE):
            if tabel[r][k] == c:
                return r, k

    raise ValueError(f"Simbolul {c} nu exista in tabel")

# Imparte mesajul in perechi
# Intre litere identice se pune X, iar dupa X se pune Q
def creeaza_perechi(mesaj):
    perechi = []
    i = 0

    while i < len(mesaj):
        a = mesaj[i]
        completare = "Q" if a == "X" else "X"

        if i + 1 < len(mesaj) and mesaj[i + 1] != a:
            perechi.append((a, mesaj[i + 1]))
            i += 2
        else:
            perechi.append((a, completare))
            i += 1

    return perechi

# Regulile Playfair
# pas = 1 pentru criptare
# pas = -1 pentru decriptare
def transforma_pereche(tabel, a, b, pas):
    ra, ca = gaseste_pozitie(tabel, a)
    rb, cb = gaseste_pozitie(tabel, b)

    if ra == rb:
        # Aceeasi linie
        return (
            tabel[ra][(ca + pas) % COLOANE]
            + tabel[rb][(cb + pas) % COLOANE]
        )

    if ca == cb:
        # Aceeasi coloana
        return (
            tabel[(ra + pas) % RANDURI][ca]
            + tabel[(rb + pas) % RANDURI][cb]
        )

    # Dreptunghi
    return tabel[ra][cb] + tabel[rb][ca]

# Cripteaza mesajul
def cripteaza(mesaj, tabel):
    rezultat = ""

    for a, b in creeaza_perechi(mesaj):
        rezultat += transforma_pereche(tabel, a, b, 1)

    return rezultat

# Decripteaza criptograma
def decripteaza(cripto, tabel):
    rezultat = ""

    for i in range(0, len(cripto), 2):
        rezultat += transforma_pereche(
            tabel, cripto[i], cripto[i + 1], -1
        )

    return rezultat

# Programul principal
def main():
    while True:
        print("\nALGORITMUL PLAYFAIR")
        print("1 - Criptare")
        print("2 - Decriptare")
        print("0 - Iesire")

        alegere = input("Alege operatia: ").strip()

        if alegere == "0":
            print("Programul s-a incheiat")
            break

        if alegere not in ("1", "2"):
            print("Introdu 1, 2 sau 0.")
            continue

        cheie = citeste_cheie()
        tabel = construieste_tabel(cheie)
        afiseaza_tabel(tabel)

        if alegere == "1":
            mesaj = citeste_mesaj()
            print("\nCriptograma:", cripteaza(mesaj, tabel))

        else:
            cripto = citeste_criptograma()
            print(
                "\nMesajul decriptat:",
                decripteaza(cripto, tabel)
            )
            print(
                "Elimina manual X/Q ajutatoare si adauga spatiile."
            )

if __name__ == "__main__":
    main()